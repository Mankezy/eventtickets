# .env faylidan nusxa oling: cp .env.example .env
# Maxfiy kalitlarni hech qachon kodga yoki gitga joylamang!

# Django maxfiy kaliti (uzun, tasodifiy satr). Ishlab chiqarishda majburiy!
SECRET_KEY=django-insecure-change-me-to-a-long-random-string

# 1 = debug rejimi (lokal), 0 = ishlab chiqarish
DEBUG=1

# Ruxsat etilgan hostlar (vergul bilan ajratilgan)
ALLOWED_HOSTS=127.0.0.1,localhost

# Render/PostgreSQL uchun ixtiyoriy. Bo'sh qoldirilsa SQLite ishlaydi.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Render demo rejimida media fayllarni Django orqali berish uchun
SERVE_LOCAL_MEDIA=0

# Render domeni uchun, masalan: https://eventtickets.onrender.com
CSRF_TRUSTED_ORIGINS=
